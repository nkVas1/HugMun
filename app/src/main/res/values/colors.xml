<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the handful of colours the platform needs before Compose starts: the splash
  screen and the system bars. Everything else lives in :core:designsystem, where it is
  covered by the contrast test.

  There is deliberately no night variant of the splash background. The app renders in
  its light palette regardless of the system setting, so a dark splash would hand over
  to a light first frame and flash — and a flash is the one thing this product should
  never do.
-->
<resources>
    <color name="splash_background">#FBF7F1</color>
</resources>
